; Cargo Yard — original cartoon construction logistics puzzle.
; Open with Godot 4.5.2 or later compatible Godot 4 release.
config_version=5

[application]
config/name="Cargo Yard"
config/description="Грузовой двор: cartoon construction trucks, a material conveyor, and directional parking puzzles for iOS and Android."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=540
window/size/viewport_height=1171
window/size/window_width_override=540
window/size/window_height_override=1171
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1
window/dpi/allow_hidpi=true

[filesystem]
import/blender/enabled=false

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.698039, 0.690196, 0.713725, 1)
