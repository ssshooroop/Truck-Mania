msgstr "Yükü henüz gelmeyen kamyonlarla yerleri doldurma."

msgctxt "scripts.ui.modal_catalog.9e4d256050a3"
msgid "Пропустить обучение"
msgstr "Eğitimi Atla"

msgctxt "scripts.ui.modal_catalog.48dccafab27d"
msgid "Все места у склада заняты.\nОткрой ещё одно — и продолжай!"
msgstr "Depodaki tüm yerler dolu.\nBir tane daha aç ve devam et!"

msgctxt "scripts.ui.modal_catalog.c60d2d77d06d"
msgid "Открыть место"
msgstr "Yer Aç"

msgctxt "scripts.ui.modal_catalog.aa882b151605"
msgid "Место за рекламу"
msgstr "Reklamla Yer"

msgctxt "scripts.ui.modal_catalog.6909d293a79e"
msgid "Ролик готовится…"
msgstr "Video geliyor…"

msgctxt "scripts.ui.modal_catalog.cf19cb36e0bd"
msgid "Кран переставит нужную машину прямо к складу."
msgstr "Vinç doğru kamyonu doğrudan depoya taşır."

msgctxt "scripts.ui.modal_catalog.25b355813f82"
msgid "Вызвать кран"
msgstr "Vinç Çağır"

msgctxt "scripts.ui.modal_catalog.2398ba31360b"
msgid "Помощь в этой попытке закончилась.\nОтмени ход или начни заново."
msgstr "Bu denemede yardım hakkın bitti.\nGeri al veya baştan başla."

msgctxt "scripts.ui.modal_catalog.0abf7381f65f"
msgid "Место и нужная машина"
msgstr "Yer ve doğru kamyon"

msgctxt "scripts.ui.modal_catalog.4367e0063eba"
msgid "Взять"
msgstr "Al"

msgctxt "scripts.ui.modal_catalog.8d589b0c3c10"
msgid "Отменить ход"
msgstr "Geri Al"

msgctxt "scripts.ui.modal_catalog.19640d8d48a9"
msgid "Бесплатно: ещё %d"
msgstr "Ücretsiz: %d kaldı"

msgctxt "scripts.ui.modal_catalog.f40432b44242"
msgid "Вернуть последнюю машину"
msgstr "Son Kamyonu Geri Al"

msgctxt "scripts.ui.modal_catalog.086406bd4bfe"
msgid "Перемешать груз"
msgstr "Yükü Karıştır"

msgctxt "scripts.ui.modal_catalog.ab24f870e1e9"
msgid "Новый порядок на ленте"
msgstr "Bantta yeni sıra"

msgctxt "scripts.ui.modal_catalog.0c7925af0933"
msgid "Начать уровень заново"
msgstr "Baştan Başla"

msgctxt "scripts.ui.modal_catalog.6d45f7c36311"
msgid "Парковка заполнена!"
msgstr "Park dolu!"

msgctxt "scripts.ui.modal_catalog.07cb65087477"
msgid "Убрать"
msgstr "Kaldır"

msgctxt "scripts.ui.modal_catalog.0aece7c229eb"
msgid "Убрать конус?"
msgstr "Koni gitsin mi?"

msgctxt "scripts.ui.modal_catalog.26bf5538561c"
msgid "Четвёртое место у склада\nдо конца этой попытки."
msgstr "Depoda dördüncü yer\nbu deneme boyunca."

msgctxt "scripts.ui.modal_catalog.b4d4430a6344"
msgid "Вызвать"
msgstr "Çağır"

msgctxt "scripts.ui.modal_catalog.2aef95648c48"
msgid "Вызвать кран?"
msgstr "Vinç gelsin mi?"

msgctxt "scripts.ui.modal_catalog.8cf3ff0db4db"
msgid "Кран поставит нужную машину\nна свободное место."
msgstr "Vinç doğru kamyonu\nboş bir yere koyar."

msgctxt "scripts.ui.modal_style.ecaab828792b"
msgid "Бесплатно"
msgstr "Ücretsiz"

msgctxt "web.wasm-loader.4ed8a7ee34b3"
msgid "Подготовка загрузки…"
msgstr "Yükleme hazırlanıyor…"

msgctxt "web.wasm-loader.3a8db977333d"
msgid "Загрузка игры: ${(bytes/1048576).toFixed(1)} / ${(total/1048576).toFixed(1)} МБ"
msgstr "Oyun yükleniyor: ${(bytes/1048576).toFixed(1)} / ${(total/1048576).toFixed(1)} MB"

msgctxt "web.wasm-loader.d2db517556a1"
msgid "Файлы загружены. Запускаем игру…"
msgstr "Dosyalar yüklendi. Oyun başlıyor…"

msgctxt "web.wasm-loader.c9a6e2e1026a"
msgid "Не удалось загрузить игру. "
msgstr "Oyun yüklenemedi."

msgctxt "web.wasm-loader.5189135a6110"
msgid "Повторить"
msgstr "Yeniden dene"

msgctxt "web.wasm-loader.9c14e5456dd5"
msgid "Запуск занимает слишком долго. Попробуйте перезагрузить страницу."
msgstr "Başlatma çok uzun sürüyor. Sayfayı yenilemeyi deneyin."

msgctxt "web.wasm-loader.edb5706027b7"
msgid "Ошибка загрузки (${response.status})."
msgstr "Yükleme hatası (${response.status})."

msgctxt "web.wasm-loader.ae4e27ff7bd9"
msgid "Проверьте вход в свой аккаунт ChatGPT в Safari."
msgstr "Safari'de ChatGPT oturumunuzu kontrol edin."

msgctxt "web.wasm-loader.a8161b487809"
msgid "Обновите браузер для запуска игры."
msgstr "Lütfen tarayıcınızı güncelleyin."

msgctxt "web.wasm-loader.1c5e2746e50d"
msgid "Файл загружен не полностью. Обновите страницу."
msgstr "Dosya tam yüklenmedi. Sayfayı yenileyin."

