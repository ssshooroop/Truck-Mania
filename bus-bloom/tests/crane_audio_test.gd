extends SceneTree
func _initialize(): run.call_deferred()
func run():
	var audio=preload("res://scripts/game_audio.gd").new()
	root.add_child(audio)
	audio.start_crane()
	assert(audio.crane.playing)
	audio.effect("bump")
	assert(audio.crane.playing)
	audio.pause_effects(true)
	assert(audio.crane.stream_paused)
	audio.pause_effects(false)
	audio.stop_crane()
	assert(not audio.crane.playing)
	audio.start_crane()
	audio.set_preferences(false,false)
	assert(not audio.crane.playing)
	audio.start_crane()
	assert(not audio.crane.playing)
	audio.set_preferences(false,true)
	audio.start_crane()
	audio.stop_effects()
	assert(not audio.crane.playing)
	audio.queue_free()
	await process_frame
	print("Crane audio: start, independent contact, pause, stop and mute passed")
	quit()
