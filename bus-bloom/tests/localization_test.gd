extends SceneTree
const Loc = preload("res://scripts/localization.gd")
const Text = preload("res://scripts/ui/localized_text.gd")
const FontAsset = preload("res://assets/fonts/MPLUSRounded1c-Bold.ttf")
func _initialize():
	Loc.initialize()
	for language in Loc.SUPPORTED:
		Loc.set_locale(language)
		assert(Loc.text("Нужно 100 монет").contains("100"))
		assert(Loc.text("Нужно 100 монет").contains("{{coin}}"))
		assert(not Loc.text("Нужно 100 монет").contains("%d"))
		var shaped = Text.line("Нужно 100 монет",FontAsset,24)
		assert(shaped.get_objects().size()==1)
		assert(shaped.get_object_rect(0).size.x>0)
	Loc.set_locale("en-US")
	assert(Loc.locale=="en")
	assert(Loc.text("День 3")=="Day 3")
	assert(Loc.text("Открыть за 100 монет")=="Unlock for 100 {{coin}}")
	assert(Loc.text("Нужно ещё 5 монет.").contains("5"))
	Loc.set_locale("ru")
	assert(Loc.text("День 3")=="День 3")
	assert(Loc.text("Поддержка")=="Поддержка")
	Loc.set_locale("xx")
	assert(Loc.locale=="en")
	print("Localization: 11 locales, dynamic counts, inline icons and fallback passed")
	quit()
